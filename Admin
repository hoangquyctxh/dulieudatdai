<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Bảng điều khiển cán bộ</title>
<style>
:root{--pri:#0d47a1;--pri2:#1976d2;--ok:#2e7d32;--warn:#ef6c00;--err:#c62828;--bg:#f6f8fb;--txt:#243039;--bd:#e0e0e0}
*{box-sizing:border-box}html,body{margin:0;padding:0}
body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:var(--bg);color:var(--txt)}
header{display:flex;align-items:center;gap:12px;padding:12px 16px;background:#fff;border-bottom:3px solid var(--pri)}
header h1{font-size:18px;margin:0;color:var(--pri)}
.container{max-width:1100px;margin:18px auto;background:#fff;border:1px solid #ecf0f3;border-radius:12px;box-shadow:0 2px 10px #00000010;padding:16px}
.row{display:flex;gap:10px;flex-wrap:wrap}
input,select,button,textarea{font-size:14px}
input[type=text],input[type=password],select,textarea{border:1px solid var(--bd);border-radius:8px;padding:9px 10px}
button{border:none;border-radius:8px;padding:10px 14px;font-weight:700;cursor:pointer}
.btn{background:var(--pri);color:#fff}.btn:hover{background:var(--pri2)}
.btn-grey{background:#eceff1}.btn-grey:hover{background:#e2e7ec}
.badge{padding:2px 6px;border-radius:6px;font-size:12px;border:1px solid #d7e3ff;background:#edf3ff;color:#153a7a}
.toolbar{display:flex;gap:8px;align-items:center;margin:10px 0;flex-wrap:wrap}
.table{width:100%;border-collapse:collapse;border:1px solid #eef2f6}
.table th,.table td{border-bottom:1px solid #eef2f6;padding:8px 10px;text-align:left;font-size:14px}
.table th{background:#f8fafe}
.pagination{display:flex;gap:6px;justify-content:flex-end;margin-top:8px}
.pagebtn{padding:6px 9px;border:1px solid #dfe5ea;border-radius:6px;background:#fff;cursor:pointer}
.pagebtn.active{background:#e8f1fd;border-color:#cfe0ff}
.right{margin-left:auto}
.status-chip{padding:2px 8px;border-radius:999px;font-size:12px;border:1px solid #e0e0e0}
.s-wait{background:#fff7e6;border-color:#ffd699;color:#8a5200}
.s-proc{background:#eaf7ff;border-color:#bfe4ff;color:#0b507a}
.s-done{background:#ecfaef;border-color:#bfeac7;color:#1e6b28}
.s-need{background:#ffefef;border-color:#ffc7c7;color:#8a0b0b}
.card{border:1px solid #eef2f6;border-radius:10px;padding:12px}
.hidden{display:none}
.login{max-width:440px;margin:14vh auto;background:#fff;border:1px solid #ecf0f3;border-radius:12px;box-shadow:0 2px 10px #00000010;padding:18px}
</style>
</head>
<body>
<header><h1>Bảng điều khiển cán bộ</h1><span class="badge">Nội bộ</span></header>

<!-- LOGIN -->
<div id="login" class="login">
  <h3>Đăng nhập quản trị</h3>
  <p>Nhập mật khẩu truy cập: </p>
  <div class="row">
    <input id="pw" type="password" placeholder="Mật khẩu nội bộ" style="flex:1">
    <button class="btn" id="go">Đăng nhập</button>
  </div>
  <p id="msg" style="color:#c62828;margin-top:8px"></p>
</div>

<!-- APP -->
<div id="app" class="container hidden">
  <div class="toolbar">
    <strong>Bộ lọc:</strong>
    <input id="q" type="text" placeholder="Tìm theo tên, CCCD, điện thoại..." style="min-width:220px">
    <select id="fTdp"><option value="">Tất cả TDP</option></select>
    <select id="fStatus">
      <option value="">Tất cả trạng thái</option>
      <option value="Chờ duyệt">Chờ duyệt</option>
      <option value="Đang xử lý">Đang xử lý</option>
      <option value="Hoàn tất">Hoàn tất</option>
      <option value="Bổ sung">Bổ sung</option>
    </select>
    <button class="btn" id="reload">Tải dữ liệu</button>
    <button class="btn-grey right" id="export">Xuất CSV</button>
  </div>

  <div class="card">
    <table class="table" id="tbl">
      <thead>
        <tr>
          <th>#</th>
          <th>Họ tên</th>
          <th>CCCD</th>
          <th>Địa chỉ</th>
          <th>Điện thoại</th>
          <th>Ngày gửi</th>
          <th>Trạng thái</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
    <div class="pagination" id="pager"></div>
  </div>

  <div class="card" id="detail" style="margin-top:12px">
    <h3>Chi tiết hồ sơ</h3>
    <div id="dnone" class="small">Chọn một hồ sơ để xem chi tiết.</div>
    <div id="dwrap" class="hidden">
      <div class="row">
        <div style="flex:2">
          <div><b>Họ tên:</b> <span id="dName"></span></div>
          <div><b>CCCD:</b> <span id="dCCCD"></span></div>
          <div><b>Địa chỉ:</b> <span id="dAddr"></span></div>
          <div><b>Điện thoại:</b> <span id="dPhone"></span></div>
          <div><b>Ngày gửi:</b> <span id="dTime"></span></div>
        </div>
        <div style="flex:1">
          <div><b>Folder:</b> <a id="dFolder" href="#" target="_blank">Mở Drive</a></div>
          <div class="small" id="dHint">Mở thư mục để xem tệp PDF/ảnh người dân đã nộp.</div>
        </div>
      </div>

      <div class="row" style="margin-top:10px">
        <div style="flex:1">
          <label>Trạng thái xử lý</label>
          <select id="dStatus">
            <option>Chờ duyệt</option>
            <option>Đang xử lý</option>
            <option>Hoàn tất</option>
            <option>Bổ sung</option>
          </select>
        </div>
        <div style="flex:2">
          <label>Ghi chú nội bộ</label>
          <textarea id="dNote" rows="3" placeholder="Ghi chú ngắn cho hồ sơ này..."></textarea>
        </div>
      </div>
      <div class="actions">
        <span></span>
        <button id="save" class="btn">Lưu cập nhật</button>
      </div>
    </div>
  </div>
</div>

<script>
(()=>{
// Mật khẩu
const PASS = "admin@2003";
// Helper
const $ = sel => document.querySelector(sel);
// Login
const login = $("#login"), app = $("#app"), msg = $("#msg");
$("#go").onclick = () => {
  const input = $("#pw").value.trim();
  if (input === PASS) {
    login.classList.add("hidden");
    app.classList.remove("hidden");
    initApp();
  } else {
    msg.textContent = "Mật khẩu không đúng.";
  }
};

// App state
let rows = [];     // dữ liệu từ Sheet
let rowsView = []; // dữ liệu sau lọc
let page = 1, per = 10, activeIdx = -1;

// UI refs
const q = $("#q"), fTdp = $("#fTdp"), fStatus = $("#fStatus");
const tbl = $("#tbl tbody"), pager = $("#pager");
const dwrap = $("#dwrap"), dnone = $("#dnone");
const dName=$("#dName"), dCCCD=$("#dCCCD"), dAddr=$("#dAddr"), dPhone=$("#dPhone"), dTime=$("#dTime"), dFolder=$("#dFolder");
const dStatus=$("#dStatus"), dNote=$("#dNote");

// Khởi động app
function initApp(){
  for(let i=1;i<=46;i++){ const op=document.createElement('option'); op.value='TDP '+i; op.textContent='TDP '+i; fTdp.appendChild(op); }
  $("#reload").onclick = loadData;
  $("#export").onclick = exportCsv;
  q.oninput = applyFilter;
  fTdp.onchange = applyFilter;
  fStatus.onchange = applyFilter;
  $("#save").onclick = saveCurrent;
  loadData();
}

// Gọi server: lấy danh sách
function loadData(){
  tbl.innerHTML = '<tr><td colspan="8">Đang tải...</td></tr>';
  google.script.run.withSuccessHandler(res=>{
    rows = res || [];
    page = 1;
    applyFilter();
  }).withFailureHandler(err=>{
    tbl.innerHTML = '<tr><td colspan="8" style="color:#c62828">Lỗi tải dữ liệu: '+(err&&err.message?err.message:'Không xác định')+'</td></tr>';
  }).admin_list();
}

// Lọc
function applyFilter(){
  const kw = q.value.trim().toLowerCase();
  const ftdp = fTdp.value;
  const fs = fStatus.value;
  rowsView = rows.filter(r=>{
    const matchKw = !kw || (r.name.toLowerCase().includes(kw) || r.cccd.toLowerCase().includes(kw) || r.phone.toLowerCase().includes(kw) || r.address.toLowerCase().includes(kw));
    const matchT = !ftdp || r.address.includes(ftdp);
    const matchS = !fs || r.status===fs;
    return matchKw && matchT && matchS;
  });
  renderTable();
}

// Render bảng + phân trang
function renderTable(){
  const total = rowsView.length;
  const totalPage = Math.max(1, Math.ceil(total / per));
  page = Math.min(page, totalPage);
  const start = (page-1)*per;
  const list = rowsView.slice(start, start+per);

  if(!total){
    tbl.innerHTML = '<tr><td colspan="8">Không có hồ sơ.</td></tr>';
    pager.innerHTML = '';
    showNone();
    return;
  }

  tbl.innerHTML = list.map((r,idx)=>`
    <tr data-idx="${start+idx}">
      <td>${start+idx+1}</td>
      <td>${r.name}</td>
      <td>${r.cccd}</td>
      <td>${r.address}</td>
      <td>${r.phone}</td>
      <td>${r.time}</td>
      <td>${statusChip(r.status||'Chờ duyệt')}</td>
      <td>
        <button class="btn-grey" onclick="void(0)">Xem</button>
        <a class="btn" style="text-decoration:none" href="${r.folder}" target="_blank">Mở Drive</a>
      </td>
    </tr>
  `).join('');

  // gán click
  [...tbl.querySelectorAll('tr')].forEach(tr=>{
    tr.addEventListener('click',()=>{
      const idx = Number(tr.dataset.idx);
      activeIdx = idx;
      showDetail(rowsView[idx]);
    });
  });

  // pager
  pager.innerHTML = '';
  for(let i=1;i<=totalPage;i++){
    const b=document.createElement('button');
    b.className='pagebtn'+(i===page?' active':'');
    b.textContent=i;
    b.onclick=()=>{page=i;renderTable();}
    pager.appendChild(b);
  }
}

function statusChip(s){
  const map = { 'Chờ duyệt':'s-wait','Đang xử lý':'s-proc','Hoàn tất':'s-done','Bổ sung':'s-need' };
  const cls = map[s]||'s-wait';
  return `<span class="status-chip ${cls}">${s}</span>`;
}

function showDetail(r){
  dnone.classList.add('hidden');
  dwrap.classList.remove('hidden');
  dName.textContent = r.name;
  dCCCD.textContent = r.cccd;
  dAddr.textContent = r.address;
  dPhone.textContent = r.phone;
  dTime.textContent = r.time;
  dFolder.href = r.folder;
  dStatus.value = r.status || 'Chờ duyệt';
  dNote.value = r.note || '';
}

function showNone(){
  dwrap.classList.add('hidden');
  dnone.classList.remove('hidden');
}

function saveCurrent(){
  if(activeIdx<0){alert('Chưa chọn hồ sơ.');return;}
  const r = rowsView[activeIdx];
  const payload = { row: r.rowIndex, status: dStatus.value, note: dNote.value };
  const btn = $("#save"); const old = btn.textContent; btn.textContent='Đang lưu...'; btn.disabled=true;
  google.script.run.withSuccessHandler(ok=>{
    btn.textContent=old; btn.disabled=false;
    // cập nhật local
    const found = rows.find(x=>x.rowIndex===r.rowIndex);
    if(found){ found.status = payload.status; found.note = payload.note; }
    applyFilter();
    const updated = rows.find(x=>x.rowIndex===r.rowIndex);
    if(updated) showDetail(updated);
  }).withFailureHandler(err=>{
    btn.textContent=old; btn.disabled=false;
    alert('Lỗi lưu: '+(err&&err.message?err.message:'Không xác định'));
  }).admin_update(payload);
}

function exportCsv(){
  const header = ['Họ tên','CCCD','Địa chỉ','Điện thoại','Ngày gửi','URL thư mục','Trạng thái','Ghi chú'];
  const lines = [header.join(',')].concat(rowsView.map(r=>[
    csv(r.name), csv(r.cccd), csv(r.address), csv(r.phone), csv(r.time), csv(r.folder), csv(r.status||''), csv(r.note||'')
  ].join(',')));
  const blob = new Blob([lines.join('\n')],{type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href=url; a.download='hoso_export.csv'; a.click();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
}
function csv(s){ return `"${String(s).replace(/"/g,'""')}"`; }

// Expose (nếu cần)
window.showDetail = showDetail;

})();
</script>
</body>
</html>
